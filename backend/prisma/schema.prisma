generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FinancialType {
  PAYABLE
  RECEIVABLE
}

enum ParcelStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELED
}

enum PaymentMethod {
  CASH
  PIX
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
}

enum UserRole {
  ADMIN
  VENDEDOR
  ESTOQUISTA
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELED
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now()) // ✅ adicionar
  products  Product[]
}

model Category {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now()) // ✅ adicionar
  products  Product[]
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String?
  brandId     String
  categoryId  String

  brand    Brand    @relation(fields: [brandId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  variants ProductVariant[]

  createdAt DateTime @default(now())
}

model ProductVariant {
  id        String  @id @default(uuid())
  name      String
  code      String  @unique
  barcode   String? @unique // campo de código de barras opcional e único
  productId String

  product Product @relation(fields: [productId], references: [id])

  createdAt      DateTime        @default(now())
  inventory      Inventory?
  stockMovements StockMovement[]
}

model Inventory {
  id               String   @id @default(uuid())
  productVariantId String   @unique
  quantity         Int
  reservedQuantity Int
  minimumStock     Int
  createdAt        DateTime @default(now()) // ✅ adicionado

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
}

model StockMovement {
  id               String            @id @default(uuid())
  productVariantId String
  type             StockMovementType
  quantity         Int
  createdAt        DateTime          @default(now())

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
}

model Sale {
  id          String   @id @default(uuid())
  customerId  String
  totalAmount Decimal
  createdAt   DateTime @default(now())

  status SaleStatus @default(COMPLETED) // 🔥 NOVO

  customer Customer   @relation(fields: [customerId], references: [id])
  items    SaleItem[]
}

model SaleItem {
  id               String @id @default(uuid())
  saleId           String
  productVariantId String
  quantity         Int
  price            Float
  sale             Sale   @relation(fields: [saleId], references: [id])
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  sales     Sale[]
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      UserRole?
  createdAt DateTime  @default(now())

  @@map("users") // opcional: nome da tabela no banco
}

model FinancialDocument {
  id String @id @default(uuid())

  type FinancialType

  referenceId String

  customerId String?
  supplierId String?

  totalAmount Decimal @default(0)

  createdAt DateTime @default(now())

  parcels FinancialParcel[]
}

model FinancialParcel {
  id String @id @default(uuid())

  financialDocumentId String

  amount Decimal

  dueDate DateTime

  status ParcelStatus @default(OPEN)

  financialDocument FinancialDocument @relation(fields: [financialDocumentId], references: [id], onDelete: Cascade)

  payments Payment[]
}

model Payment {
  id String @id @default(uuid())

  parcelId String

  amount Decimal

  method PaymentMethod

  paymentDate DateTime @default(now())

  createdAt DateTime @default(now())

  parcel FinancialParcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
}
