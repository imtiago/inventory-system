generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InventoryLotSource {
  PURCHASE
  IMPORT
  MANUAL
  RETURN
  TRANSFER
  PRODUCTION
}

enum PurchaseStatus {
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELED
}

enum PurchaseOrigin {
  MANUAL
  XML
  IMPORT
  REPLENISHMENT
}

enum FinancialType {
  PAYABLE
  RECEIVABLE
}

enum FinancialOriginType {
  SALE
  PURCHASE
  MANUAL
  INVOICE
}

enum FinancialPartyType {
  CUSTOMER
  SUPPLIER
}

enum FinancialStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELED
}

enum PaymentMethod {
  CASH
  PIX
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
}

enum ParcelStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELED
}

enum UserRole {
  ADMIN
  VENDEDOR
  ESTOQUISTA
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RESERVE
}

enum StockMovementOrigin {
  PURCHASE
  SALE
  IMPORT
  MANUAL
  INVENTORY
  TRANSFER
  RETURN
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELED
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now()) // ✅ adicionar
  products  Product[]
}

model Category {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now()) // ✅ adicionar
  products  Product[]
}

model Product {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  description String?
  brandId     String
  categoryId  String

  brand    Brand    @relation(fields: [brandId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  variants ProductVariant[]

  createdAt DateTime @default(now())
}

model ProductVariant {
  id        String  @id @default(uuid())
  name      String
  code      String  @unique
  barcode   String? @unique // campo de código de barras opcional e único
  productId String

  product Product @relation(fields: [productId], references: [id])

  createdAt      DateTime        @default(now())
  inventory      Inventory?
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  inventoryLots  InventoryLot[]
}

model InventoryLot {
  id String @id @default(uuid())

  inventoryId String

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  productVariantId String

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  sourceType InventoryLotSource

  sourceId String?

  initialQuantity Int

  remainingQuantity Int

  unitCost Decimal

  batchNumber String?

  manufacturingDate DateTime?

  expirationDate DateTime?

  createdAt      DateTime      @default(now())
  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id])
  purchaseItemId String?
}

model Inventory {
  id String @id @default(uuid())

  productVariantId String @unique

  quantity Int @default(0)

  reservedQuantity Int @default(0)

  minimumStock Int @default(0)

  averageCost Decimal @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  lots           InventoryLot[]

  stockMovements StockMovement[]
}

model StockMovement {
  id String @id @default(uuid())

  inventoryId String

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  productVariantId String

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  type StockMovementType

  origin StockMovementOrigin

  quantity Int

  originId String?

  userId String?

  notes String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Sale {
  id String @id @default(uuid())

  customerId String

  totalAmount Decimal @default(0)

  createdAt DateTime @default(now())

  status SaleStatus @default(PENDING)

  customer Customer @relation(fields: [customerId], references: [id])

  items SaleItem[]
}

model SaleItem {
  id String @id @default(uuid())

  saleId String

  productVariantId String

  productName String

  barcode String?

  sku String?

  quantity Int

  unitPrice Decimal

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  sales     Sale[]
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  password       String
  role           UserRole
  createdAt      DateTime        @default(now())
  stockMovements StockMovement[]

  @@map("users") // opcional: nome da tabela no banco
}

model FinancialDocument {
  id String @id @default(uuid())

  type FinancialType

  originId   String
  originType FinancialOriginType

  partyId   String
  partyType FinancialPartyType

  status FinancialStatus @default(OPEN)

  createdAt DateTime @default(now())

  parcels FinancialParcel[]
}

model FinancialParcel {
  id String @id @default(uuid())

  financialDocumentId String

  amount Decimal

  dueDate DateTime

  createdAt DateTime @default(now())

  document FinancialDocument @relation(fields: [financialDocumentId], references: [id], onDelete: Cascade)

  payments Payment[]
}

model Payment {
  id String @id @default(uuid())

  parcelId String

  amount Decimal

  method PaymentMethod

  reference String?

  paymentDate DateTime @default(now())

  createdAt DateTime @default(now())

  parcel FinancialParcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
}

model NumberRange {
  id String @id @default(uuid())

  name         String @unique
  currentValue Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id String @id @default(uuid())

  name String

  document String @unique

  email String?

  phone String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  purchases Purchase[]
}

model Purchase {
  id String @id @default(uuid())

  supplierId String

  supplier Supplier @relation(fields: [supplierId], references: [id])

  status PurchaseStatus

  origin PurchaseOrigin

  purchaseDate DateTime

  totalAmount Decimal @default(0)

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  items PurchaseItem[]
}

model PurchaseItem {
  id String @id @default(uuid())

  purchaseId String

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productVariantId String

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  quantity Int

  receivedQuantity Int @default(0)

  unitPrice Decimal

  discount Decimal @default(0)

  freight Decimal @default(0)

  tax Decimal @default(0)

  total Decimal

  inventoryLots InventoryLot[]
}
