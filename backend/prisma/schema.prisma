generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InventoryLotSource {
  PURCHASE
  IMPORT
  MANUAL
  RETURN
  TRANSFER
  PRODUCTION
}

enum PurchaseStatus {
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELED
}

enum NfeImportStatus {
  DRAFT
  CONFIRMED
  // Desfeita (POST /nfe-imports/:id/revert); reenviar a mesma chave volta a linha para DRAFT.
  REVERTED
}

enum PurchaseOrigin {
  MANUAL
  XML
  IMPORT
  REPLENISHMENT
}

enum FinancialType {
  PAYABLE
  RECEIVABLE
}

enum FinancialOriginType {
  SALE
  PURCHASE
  MANUAL
  INVOICE
}

enum FinancialPartyType {
  CUSTOMER
  SUPPLIER
}

enum FinancialStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELED
}

enum PaymentMethod {
  CASH
  PIX
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
}

enum PaymentCondition {
  CASH
  PIX
  DEBIT_CARD
  CREDIT_CARD
  CREDIARIO
  LEGACY_INSTALLMENTS
}

enum ParcelStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELED
}

enum UserRole {
  ADMIN
  VENDEDOR
  ESTOQUISTA
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RESERVE
  RELEASE
}

enum StockMovementOrigin {
  PURCHASE
  SALE
  IMPORT
  MANUAL
  INVENTORY
  TRANSFER
  RETURN
}

// PENDING não é criado por nenhum fluxo (o domínio nasce COMPLETED); o default do banco só vale para
// inserção fora da aplicação. Mantido porque filtro, CSV e front ainda o conhecem.
enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELED
}

// Nome único sem diferença de caixa: índice de expressão "Brand_name_lower_key"
// ON "Brand" (lower(name)), criado só na migration 20261023200000_brand_category_unique_name
// (o Prisma não modela índice de expressão). Violação → P2002 → 409 BRAND_ALREADY_EXISTS.
model Brand {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now()) // ✅ adicionar
  products  Product[]
}

// Nome único sem diferença de caixa: índice de expressão "Category_name_lower_key"
// ON "Category" (lower(name)), criado só na migration 20261023200000_brand_category_unique_name
// (o Prisma não modela índice de expressão). Violação → P2002 → 409 CATEGORY_ALREADY_EXISTS.
model Category {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now()) // ✅ adicionar
  products  Product[]
  /// Margem-alvo da categoria em bps (CHECK 0..9999 só na migration); null = herda.
  targetMarginBps Int?
}

model Product {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  description String?
  brandId     String
  categoryId  String
  targetMarginBps Int?

  brand    Brand    @relation(fields: [brandId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  variants ProductVariant[]

  createdAt DateTime @default(now())

  @@index([brandId])
  @@index([categoryId])
}

model ProductVariant {
  id        String  @id @default(uuid())
  name      String
  code      String  @unique
  barcode   String? @unique // campo de código de barras opcional e único
  productId String

  salePrice Decimal @default(0) @db.Decimal(12, 2)
  targetMarginBps Int?
  supplierSuggestedPrice          Decimal? @db.Decimal(12, 2) // CHECK > 0 só na migration
  supplierSuggestedPriceUpdatedAt DateTime?

  product Product @relation(fields: [productId], references: [id])

  createdAt      DateTime        @default(now())
  inventory      Inventory?
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  inventoryLots  InventoryLot[]

  supplierProductMappings SupplierProductMapping[]
  priceReviews            PriceReview[]

  @@index([productId])
}

model InventoryLot {
  id String @id @default(uuid())

  inventoryId String

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  productVariantId String

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  sourceType InventoryLotSource

  sourceId String?

  initialQuantity Int

  remainingQuantity Int

  unitCost Decimal @db.Decimal(14, 4)

  // Parte do unitCost que veio de frete/despesas/impostos (por unidade). CHECK >= 0 só na migration.
  acquisitionExtraCost Decimal @default(0) @db.Decimal(14, 4)

  batchNumber String?

  manufacturingDate DateTime?

  expirationDate DateTime?

  createdAt      DateTime            @default(now())
  purchaseItem   PurchaseItem?       @relation(fields: [purchaseItemId], references: [id])
  purchaseItemId String?
  boxStocks      InventoryBoxStock[]
  stockMovements StockMovement[]

  @@unique([productVariantId, batchNumber])

  @@index([expirationDate])

  @@index([inventoryId, remainingQuantity])
}

model Inventory {
  id String @id @default(uuid())

  productVariantId String @unique

  quantity Int @default(0)

  reservedQuantity Int @default(0)

  minimumStock Int @default(0)

  averageCost Decimal @default(0) @db.Decimal(14, 4)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  lots           InventoryLot[]

  stockMovements StockMovement[]
}

model StockMovement {
  id String @id @default(uuid())

  inventoryId String

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  productVariantId String

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  type StockMovementType

  origin StockMovementOrigin

  quantity Int

  previousQuantity Int?

  currentQuantity Int?

  averageCost Decimal? @db.Decimal(14, 4)

  inventoryLotId String?

  inventoryLot InventoryLot? @relation(fields: [inventoryLotId], references: [id], onDelete: SetNull)

  originId String?

  userId String?

  notes String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([origin, originId])
  @@index([productVariantId, createdAt])
  @@index([inventoryId, createdAt])
  @@index([inventoryLotId])
  @@index([createdAt])
}

model Sale {
  id String @id @default(uuid())

  customerId String

  sellerId String?

  totalAmount Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  status SaleStatus @default(PENDING)

  /// Condição escolhida no fechamento; vendas antigas = LEGACY_INSTALLMENTS.
  paymentCondition PaymentCondition @default(LEGACY_INSTALLMENTS)
  cardFeePassedOn  Boolean          @default(false)
  /// 1..12 (CHECK na migration), só CREDIT_CARD.
  cardInstallments Int?
  /// Taxa do cartão aplicada (snapshot), só cartão.
  cardFeeBps       Int?
  /// Repasse da taxa / acréscimo do crediário (CHECK >= 0). totalAmount = itens + surchargeAmount.
  surchargeAmount  Decimal          @default(0) @db.Decimal(12, 2)
  downPayment      Decimal          @default(0) @db.Decimal(12, 2)

  customer Customer @relation(fields: [customerId], references: [id])

  seller User? @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  items SaleItem[]

  cancelRequests SaleCancelRequest[]

  @@index([status, createdAt])

  @@index([customerId])
  @@index([createdAt])
}

model SaleItem {
  id String @id @default(uuid())

  saleId String

  productVariantId String

  productName String

  barcode String?

  sku String?

  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)

  // Custo médio da variante no momento da venda; NULL em vendas anteriores ao registro.
  unitCost Decimal? @db.Decimal(14, 4)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([saleId])
}

// CPF/CNPJ opcional e único: índice único PARCIAL "Customer_document_key"
// ON "Customer" (document) WHERE document IS NOT NULL, criado só na migration
// 20261026120000_customer_document (o Prisma não modela índice parcial, por isso a
// coluna não é @unique aqui). Violação → P2002 → 409 CUSTOMER_DOCUMENT_EXISTS.
model Customer {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  document  String?
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  sales     Sale[]

  /// Ficha de crédito (crediário). Trava: `FOR NO KEY UPDATE` (CustomerCreditRepository.lock/lockMany, ORDER BY id).
  creditProfileCode CreditProfileCode @default(NEW)
  /// CHECK (>= 0) na migration 20261029100200_credit_settings_profiles.
  creditLimit       Decimal           @default(300.00) @db.Decimal(12, 2)
  creditStatus      CreditStatus      @default(ACTIVE)
  creditProfile     CreditProfile     @relation(fields: [creditProfileCode], references: [code], onDelete: Restrict)
  creditChanges     CreditLimitChange[]
}

model User {
  id                  String          @id @default(uuid())
  name                String
  email               String          @unique
  password            String
  role                UserRole
  active              Boolean         @default(true)
  createdAt           DateTime        @default(now())
  /// Última troca/redefinição de senha: tokens com `iat` anterior (em segundos) são recusados.
  passwordChangedAt   DateTime?
  /// Pode aprovar crédito além do papel (ADMIN sempre pode).
  canApproveCredit    Boolean         @default(false)
  stockMovements      StockMovement[]
  sales               Sale[]
  paymentsCreated     Payment[]       @relation("paymentsCreated")
  paymentsReversed    Payment[]       @relation("paymentsReversed")
  purchasesCanceled   Purchase[]      @relation("purchasesCanceled")
  nfeImportsCreated   NfeImport[]     @relation("nfeImportsCreated")
  nfeImportsConfirmed NfeImport[]     @relation("nfeImportsConfirmed")
  pricingSettingsUpdated PricingSettings[]
  priceReviewsResolved   PriceReview[]
  saleCancelRequested    SaleCancelRequest[] @relation("saleCancelRequested")
  saleCancelDecided      SaleCancelRequest[] @relation("saleCancelDecided")
  creditSettingsEnabled  CreditSettings[]    @relation("creditSettingsEnabled")
  creditSettingsUpdated  CreditSettings[]    @relation("creditSettingsUpdated")
  creditLimitChanges     CreditLimitChange[]

  @@map("users") // opcional: nome da tabela no banco
}

model FinancialDocument {
  id String @id @default(uuid())

  type FinancialType

  originId   String
  originType FinancialOriginType

  partyId   String
  partyType FinancialPartyType

  status FinancialStatus @default(OPEN)

  createdAt DateTime @default(now())

  parcels FinancialParcel[]

  // Um documento ATIVO por origem de venda/compra: índice único PARCIAL
  // "FinancialDocument_active_origin_key" (type, originType, originId) WHERE originType IN
  // ('SALE','PURCHASE') AND status <> 'CANCELED', criado à mão em
  // 20261026180000_integrity_checks (o Prisma não modela índice parcial). Violação → P2002.
  // Essa migration também cria CHECKs (estoque >= 0, reservado <= quantidade, valores/quantidades > 0),
  // que o Prisma não modela; violação → 23514 → 409 CONSTRAINT_VIOLATION.
  @@index([type, originType, originId])
  @@index([type, partyId])
  @@index([type, status])
}

model FinancialParcel {
  id String @id @default(uuid())

  financialDocumentId String

  amount Decimal @db.Decimal(12, 2)

  dueDate DateTime

  createdAt DateTime @default(now())

  document FinancialDocument @relation(fields: [financialDocumentId], references: [id], onDelete: Restrict)

  payments Payment[]

  @@index([financialDocumentId])
}

model Payment {
  id String @id @default(uuid())

  parcelId String

  amount Decimal @db.Decimal(12, 2)

  method PaymentMethod

  reference String?

  paymentDate DateTime @default(now())

  createdAt DateTime @default(now())

  createdById String?
  createdBy   User?   @relation("paymentsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  reversedAt     DateTime?
  reversedById   String?
  reversedBy     User?     @relation("paymentsReversed", fields: [reversedById], references: [id], onDelete: SetNull)
  reversalReason String?

  /// Pago no fechamento da venda (estornado automaticamente no cancelamento).
  atCheckout Boolean @default(false)

  parcel FinancialParcel @relation(fields: [parcelId], references: [id], onDelete: Restrict)

  @@index([parcelId])
}

model NumberRange {
  id String @id @default(uuid())

  name         String @unique
  currentValue Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id String @id @default(uuid())

  name String

  document String @unique

  email String?

  phone String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  purchases Purchase[]

  productMappings SupplierProductMapping[]
}

model Purchase {
  id String @id @default(uuid())

  code String @unique

  supplierId String

  supplier Supplier @relation(fields: [supplierId], references: [id])

  status PurchaseStatus

  origin PurchaseOrigin

  // Data sem hora ("YYYY-MM-DD").
  purchaseDate DateTime @db.Date

  totalAmount Decimal @default(0) @db.Decimal(12, 2)

  // Frete/despesas do pedido, já rateados nos itens (informativo). CHECK >= 0 só na migration.
  extraCosts Decimal @default(0) @db.Decimal(12, 2)

  notes String?

  cancelReason String?

  canceledAt DateTime?

  canceledById String?

  canceledBy User? @relation("purchasesCanceled", fields: [canceledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  items PurchaseItem[]

  nfeImport NfeImport?

  @@index([status])
}

model PurchaseItem {
  id String @id @default(uuid())

  purchaseId String

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productVariantId String

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  quantity Int

  receivedQuantity Int @default(0)

  unitPrice Decimal @db.Decimal(12, 2)

  discount Decimal @default(0) @db.Decimal(12, 2)

  freight Decimal @default(0) @db.Decimal(12, 2)

  tax Decimal @default(0) @db.Decimal(12, 2)

  total Decimal @db.Decimal(12, 2)

  // Custo unitário que entra no estoque: round(total / quantity) com 4 casas.
  unitCost Decimal @db.Decimal(14, 4)

  // Ordem do item no pedido (ordem do envio na criação).
  position Int

  inventoryLots InventoryLot[]

  @@index([purchaseId])
}

model InventoryBox {
  id   String @id @default(uuid())
  code String @unique

  stocks InventoryBoxStock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryBoxStock {
  id String @id @default(uuid())

  inventoryLotId String
  inventoryLot   InventoryLot @relation(fields: [inventoryLotId], references: [id], onDelete: Cascade)

  boxId String
  box   InventoryBox @relation(fields: [boxId], references: [id])

  quantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inventoryLotId, boxId])
}

// Rascunho de importação de NF-e (XML modelo 55): conteúdo lido em `payload` (NfeDocument).
model NfeImport {
  id String @id @default(uuid())

  accessKey String @unique

  status NfeImportStatus @default(DRAFT)

  supplierDocument String

  supplierName String

  // Data sem hora ("YYYY-MM-DD").
  issueDate DateTime @db.Date

  totalAmount Decimal @db.Decimal(12, 2)

  payload Json

  purchaseId String? @unique

  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  createdById String?

  createdBy User? @relation("nfeImportsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  confirmedById String?

  confirmedBy User? @relation("nfeImportsConfirmed", fields: [confirmedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  confirmedAt DateTime?

  @@index([status, createdAt])
}

// Vínculo aprendido: código do produto no fornecedor → variante do catálogo.
// Excluir a variante só remove o vínculo (Cascade), não bloqueia a exclusão.
model SupplierProductMapping {
  id String @id @default(uuid())

  supplierId String

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  supplierCode String

  productVariantId String

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  unitsPerPackage Int @default(1)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([supplierId, supplierCode])
  @@index([productVariantId])
}

// Fase 7: chave de idempotência das operações de dinheiro/estoque. Gravada na
// mesma transação da operação (se ela falha, o registro some junto). Escopo:
// usuário + método + padrão da rota + chave. Sem FK para User: registros são
// efêmeros (removidos após 24 h) e não devem bloquear a exclusão de usuários.
model IdempotencyRecord {
  id String @id @default(uuid())

  userId String

  method String

  route String

  key String

  requestHash String

  // Preenchidos na mesma transação, antes do commit. `json` (não jsonb):
  // guarda o texto como veio, então o replay devolve as chaves na mesma ordem.
  statusCode Int?

  responseBody Json? @db.Json

  // Cabeçalhos relevantes da resposta (Location, Content-Disposition), reproduzidos no replay.
  responseHeaders Json? @db.Json

  createdAt DateTime @default(now())

  @@unique([userId, method, route, key])
  @@index([createdAt])
}

enum RoundingStrategy {
  STORE_TABLE
  END_90
  END_99
  INTEGER
  NONE
}

/// Linha única (id = 'default', CHECK na migration), criada sob demanda.
model PricingSettings {
  id                String           @id
  defaultMarginBps  Int
  roundingStrategy  RoundingStrategy @default(STORE_TABLE)
  alertThresholdBps Int              @default(200)
  /// { debitBps: number, creditBps: { "1": number, … "12": number } }
  cardFees          Json
  updatedAt         DateTime         @default(now())
  updatedById       String?
  updatedBy         User?            @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model PricingExpense {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(80)
  percentBps Int
  active     Boolean  @default(true)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
}

enum PriceReviewReason {
  COST_CHANGED
  SETTINGS_CHANGED
  MARGIN_CHANGED
  MARGIN_BELOW_TARGET
}

enum PriceReviewStatus {
  PENDING
  APPLIED
  DISMISSED
}

/// Preço para revisar. Só na migration (o Prisma não modela): único parcial
/// "PriceReview_pending_variant_key" (productVariantId) WHERE status = 'PENDING' — uma pendente por
/// variante, alvo do ON CONFLICT dos gatilhos — e CHECK de preços >= 0.
model PriceReview {
  id               String            @id @default(uuid())
  productVariantId String
  reason           PriceReviewReason
  currentPrice     Decimal           @db.Decimal(12, 2)
  suggestedPrice   Decimal           @db.Decimal(12, 2)
  status           PriceReviewStatus @default(PENDING)
  createdAt        DateTime          @default(now())
  resolvedAt       DateTime?
  resolvedById     String?

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  resolvedBy     User?          @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([productVariantId])
}

/// Pedido de cancelamento de venda (vendedor pede, ADMIN decide). Único parcial
/// "SaleCancelRequest_pending_sale_key" ON (saleId) WHERE status = 'PENDING' só na migration.
model SaleCancelRequest {
  id             String                 @id @default(uuid())
  saleId         String
  reason         String                 @db.VarChar(200)
  status         ApprovalRequestStatus  @default(PENDING)
  requestedById  String?
  requestedAt    DateTime               @default(now())
  decidedById    String?
  decidedAt      DateTime?
  decisionReason String?                @db.VarChar(200)

  sale        Sale  @relation(fields: [saleId], references: [id], onDelete: Restrict)
  requestedBy User? @relation("saleCancelRequested", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy   User? @relation("saleCancelDecided", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
}

enum CreditProfileCode {
  NEW
  REGULAR
  GOOD
  EXCELLENT
}

enum CreditStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
}

enum CreditChangeSource {
  MANUAL
  AUTO_REVIEW
  REQUEST
  LEGACY_IMPORT
}

/// Linha única (`id = 'default'`, CHECK na migration), criada pela migration com os valores iniciais da spec.
model CreditSettings {
  id               String    @id
  crediarioEnabled Boolean   @default(false)
  /// CreditRules em centavos/bps; validado por `creditRulesSchema` na escrita e na leitura.
  rules            Json
  enabledAt        DateTime?
  enabledById      String?
  updatedAt        DateTime  @default(now())
  updatedById      String?

  enabledBy User? @relation("creditSettingsEnabled", fields: [enabledById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("creditSettingsUpdated", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Perfis de crédito (4 linhas da migration). CHECKs de faixa na migration.
model CreditProfile {
  code              CreditProfileCode @id
  name              String
  initialLimit      Decimal           @db.Decimal(12, 2)
  minDownPaymentBps Int
  maxInstallments   Int
  position          Int

  customers Customer[]
}

/// Histórico da ficha de crédito: uma linha por mudança efetiva.
model CreditLimitChange {
  id          String             @id @default(uuid())
  customerId  String
  fromProfile CreditProfileCode
  toProfile   CreditProfileCode
  fromLimit   Decimal            @db.Decimal(12, 2)
  toLimit     Decimal            @db.Decimal(12, 2)
  fromStatus  CreditStatus
  toStatus    CreditStatus
  reason      String             @db.VarChar(300)
  source      CreditChangeSource
  changedById String?
  createdAt   DateTime           @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  changedBy User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
}
