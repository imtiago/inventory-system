generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InventoryLotSource {
  PURCHASE
  IMPORT
  MANUAL
  RETURN
  TRANSFER
  PRODUCTION
}

enum PurchaseStatus {
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELED
}

enum NfeImportStatus {
  DRAFT
  CONFIRMED
}

enum PurchaseOrigin {
  MANUAL
  XML
  IMPORT
  REPLENISHMENT
}

enum FinancialType {
  PAYABLE
  RECEIVABLE
}

enum FinancialOriginType {
  SALE
  PURCHASE
  MANUAL
  INVOICE
}

enum FinancialPartyType {
  CUSTOMER
  SUPPLIER
}

enum FinancialStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELED
}

enum PaymentMethod {
  CASH
  PIX
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
}

enum ParcelStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELED
}

enum UserRole {
  ADMIN
  VENDEDOR
  ESTOQUISTA
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RESERVE
  RELEASE
}

enum StockMovementOrigin {
  PURCHASE
  SALE
  IMPORT
  MANUAL
  INVENTORY
  TRANSFER
  RETURN
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELED
}

// Nome único sem diferença de caixa: índice de expressão "Brand_name_lower_key"
// ON "Brand" (lower(name)), criado só na migration 20261023200000_brand_category_unique_name
// (o Prisma não modela índice de expressão). Violação → P2002 → 409 BRAND_ALREADY_EXISTS.
model Brand {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now()) // ✅ adicionar
  products  Product[]
}

// Nome único sem diferença de caixa: índice de expressão "Category_name_lower_key"
// ON "Category" (lower(name)), criado só na migration 20261023200000_brand_category_unique_name
// (o Prisma não modela índice de expressão). Violação → P2002 → 409 CATEGORY_ALREADY_EXISTS.
model Category {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now()) // ✅ adicionar
  products  Product[]
}

model Product {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  description String?
  brandId     String
  categoryId  String

  brand    Brand    @relation(fields: [brandId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  variants ProductVariant[]

  createdAt DateTime @default(now())
}

model ProductVariant {
  id        String  @id @default(uuid())
  name      String
  code      String  @unique
  barcode   String? @unique // campo de código de barras opcional e único
  productId String

  salePrice Decimal @default(0) @db.Decimal(12, 2)

  product Product @relation(fields: [productId], references: [id])

  createdAt      DateTime        @default(now())
  inventory      Inventory?
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  inventoryLots  InventoryLot[]

  supplierProductMappings SupplierProductMapping[]
}

model InventoryLot {
  id String @id @default(uuid())

  inventoryId String

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  productVariantId String

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  sourceType InventoryLotSource

  sourceId String?

  initialQuantity Int

  remainingQuantity Int

  unitCost Decimal

  batchNumber String?

  manufacturingDate DateTime?

  expirationDate DateTime?

  createdAt      DateTime            @default(now())
  purchaseItem   PurchaseItem?       @relation(fields: [purchaseItemId], references: [id])
  purchaseItemId String?
  boxStocks      InventoryBoxStock[]
  stockMovements StockMovement[]

  @@unique([productVariantId, batchNumber])
}

model Inventory {
  id String @id @default(uuid())

  productVariantId String @unique

  quantity Int @default(0)

  reservedQuantity Int @default(0)

  minimumStock Int @default(0)

  averageCost Decimal @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  lots           InventoryLot[]

  stockMovements StockMovement[]
}

model StockMovement {
  id String @id @default(uuid())

  inventoryId String

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  productVariantId String

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  type StockMovementType

  origin StockMovementOrigin

  quantity Int

  previousQuantity Int?

  currentQuantity Int?

  averageCost Decimal?

  inventoryLotId String?

  inventoryLot InventoryLot? @relation(fields: [inventoryLotId], references: [id], onDelete: SetNull)

  originId String?

  userId String?

  notes String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Sale {
  id String @id @default(uuid())

  customerId String

  sellerId String?

  totalAmount Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  status SaleStatus @default(PENDING)

  customer Customer @relation(fields: [customerId], references: [id])

  seller User? @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  items SaleItem[]
}

model SaleItem {
  id String @id @default(uuid())

  saleId String

  productVariantId String

  productName String

  barcode String?

  sku String?

  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  sales     Sale[]
}

model User {
  id                  String          @id @default(uuid())
  name                String
  email               String          @unique
  password            String
  role                UserRole
  active              Boolean         @default(true)
  createdAt           DateTime        @default(now())
  stockMovements      StockMovement[]
  sales               Sale[]
  paymentsCreated     Payment[]       @relation("paymentsCreated")
  paymentsReversed    Payment[]       @relation("paymentsReversed")
  purchasesCanceled   Purchase[]      @relation("purchasesCanceled")
  nfeImportsCreated   NfeImport[]     @relation("nfeImportsCreated")
  nfeImportsConfirmed NfeImport[]     @relation("nfeImportsConfirmed")

  @@map("users") // opcional: nome da tabela no banco
}

model FinancialDocument {
  id String @id @default(uuid())

  type FinancialType

  originId   String
  originType FinancialOriginType

  partyId   String
  partyType FinancialPartyType

  status FinancialStatus @default(OPEN)

  createdAt DateTime @default(now())

  parcels FinancialParcel[]
}

model FinancialParcel {
  id String @id @default(uuid())

  financialDocumentId String

  amount Decimal @db.Decimal(12, 2)

  dueDate DateTime

  createdAt DateTime @default(now())

  document FinancialDocument @relation(fields: [financialDocumentId], references: [id], onDelete: Cascade)

  payments Payment[]
}

model Payment {
  id String @id @default(uuid())

  parcelId String

  amount Decimal @db.Decimal(12, 2)

  method PaymentMethod

  reference String?

  paymentDate DateTime @default(now())

  createdAt DateTime @default(now())

  createdById String?
  createdBy   User?   @relation("paymentsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  reversedAt     DateTime?
  reversedById   String?
  reversedBy     User?     @relation("paymentsReversed", fields: [reversedById], references: [id], onDelete: SetNull)
  reversalReason String?

  parcel FinancialParcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
}

model NumberRange {
  id String @id @default(uuid())

  name         String @unique
  currentValue Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id String @id @default(uuid())

  name String

  document String @unique

  email String?

  phone String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  purchases Purchase[]

  productMappings SupplierProductMapping[]
}

model Purchase {
  id String @id @default(uuid())

  code String @unique

  supplierId String

  supplier Supplier @relation(fields: [supplierId], references: [id])

  status PurchaseStatus

  origin PurchaseOrigin

  // Data sem hora ("YYYY-MM-DD").
  purchaseDate DateTime @db.Date

  totalAmount Decimal @default(0) @db.Decimal(12, 2)

  notes String?

  cancelReason String?

  canceledAt DateTime?

  canceledById String?

  canceledBy User? @relation("purchasesCanceled", fields: [canceledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  items PurchaseItem[]

  nfeImport NfeImport?
}

model PurchaseItem {
  id String @id @default(uuid())

  purchaseId String

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productVariantId String

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  quantity Int

  receivedQuantity Int @default(0)

  unitPrice Decimal @db.Decimal(12, 2)

  discount Decimal @default(0) @db.Decimal(12, 2)

  freight Decimal @default(0) @db.Decimal(12, 2)

  tax Decimal @default(0) @db.Decimal(12, 2)

  total Decimal @db.Decimal(12, 2)

  // Custo unitário que entra no estoque: round(total / quantity) em centavos.
  unitCost Decimal @db.Decimal(12, 2)

  // Ordem do item no pedido (ordem do envio na criação).
  position Int

  inventoryLots InventoryLot[]
}

model InventoryBox {
  id   String @id @default(uuid())
  code String @unique

  stocks InventoryBoxStock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryBoxStock {
  id String @id @default(uuid())

  inventoryLotId String
  inventoryLot   InventoryLot @relation(fields: [inventoryLotId], references: [id], onDelete: Cascade)

  boxId String
  box   InventoryBox @relation(fields: [boxId], references: [id])

  quantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inventoryLotId, boxId])
}

// Rascunho de importação de NF-e (XML modelo 55): conteúdo lido em `payload` (NfeDocument).
model NfeImport {
  id String @id @default(uuid())

  accessKey String @unique

  status NfeImportStatus @default(DRAFT)

  supplierDocument String

  supplierName String

  // Data sem hora ("YYYY-MM-DD").
  issueDate DateTime @db.Date

  totalAmount Decimal @db.Decimal(12, 2)

  payload Json

  purchaseId String? @unique

  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  createdById String?

  createdBy User? @relation("nfeImportsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  confirmedById String?

  confirmedBy User? @relation("nfeImportsConfirmed", fields: [confirmedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  confirmedAt DateTime?

  @@index([status, createdAt])
}

// Vínculo aprendido: código do produto no fornecedor → variante do catálogo.
// Excluir a variante só remove o vínculo (Cascade), não bloqueia a exclusão.
model SupplierProductMapping {
  id String @id @default(uuid())

  supplierId String

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  supplierCode String

  productVariantId String

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  unitsPerPackage Int @default(1)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([supplierId, supplierCode])
  @@index([productVariantId])
}
