generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  VENDEDOR
  ESTOQUISTA
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELED
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now()) // ✅ adicionar
  products  Product[]
}

model Category {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now()) // ✅ adicionar
  products  Product[]
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String?
  brandId     String
  categoryId  String
  code        String  @unique

  brand    Brand    @relation(fields: [brandId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  variants ProductVariant[]

  createdAt DateTime @default(now())
}

model ProductVariant {
  id        String  @id @default(uuid())
  name      String
  sku       String  @unique
  barcode   String? @unique // campo de código de barras opcional e único
  productId String

  product Product @relation(fields: [productId], references: [id])

  createdAt      DateTime        @default(now())
  inventory      Inventory?
  stockMovements StockMovement[]
}

model Inventory {
  id               String   @id @default(uuid())
  productVariantId String   @unique
  quantity         Int
  reservedQuantity Int
  minimumStock     Int
  createdAt        DateTime @default(now()) // ✅ adicionado

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
}

model StockMovement {
  id               String            @id @default(uuid())
  productVariantId String
  type             StockMovementType
  quantity         Int
  createdAt        DateTime          @default(now())

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
}

model Sale {
  id          String   @id @default(uuid())
  customerId  String
  totalAmount Float
  createdAt   DateTime @default(now())

  status SaleStatus @default(COMPLETED) // 🔥 NOVO

  customer    Customer     @relation(fields: [customerId], references: [id])
  items       SaleItem[]
  receivables Receivable[]
}

model SaleItem {
  id               String @id @default(uuid())
  saleId           String
  productVariantId String
  quantity         Int
  price            Float
  sale             Sale   @relation(fields: [saleId], references: [id])
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  sales     Sale[]
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      UserRole?
  createdAt DateTime  @default(now())

  @@map("users") // opcional: nome da tabela no banco
}

model Receivable {
  id          String             @id @default(uuid())
  saleId      String
  totalAmount Float
  createdAt   DateTime           @default(now())
  parcels     ReceivableParcel[]
  sale        Sale               @relation(fields: [saleId], references: [id])
}

model ReceivableParcel {
  id           String     @id @default(uuid())
  receivableId String
  amount       Float
  dueDate      DateTime
  paid         Boolean    @default(false)
  paidAt       DateTime?
  receivable   Receivable @relation(fields: [receivableId], references: [id])
}

model Payable {
  id          String          @id @default(uuid())
  purchaseId  String
  totalAmount Float
  createdAt   DateTime        @default(now())
  parcels     PayableParcel[]
}

model PayableParcel {
  id        String    @id @default(uuid())
  payableId String
  amount    Float
  dueDate   DateTime
  paid      Boolean   @default(false)
  paidAt    DateTime?
  payable   Payable   @relation(fields: [payableId], references: [id])
}
