{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "tsx --import ./src/test/bootstrap.ts --test \"src/shared/**/*.test.ts\" \"src/modules/*/domain/**/*.test.ts\" \"src/modules/*/application/**/*.test.ts\" \"src/modules/*/infrastructure/**/*.test.ts\" \"src/scripts/**/*.test.ts\"",
    "test:db:prepare": "tsx src/scripts/prepareTestDb.ts",
    "backup-db": "bash scripts/backup-db.sh",
    "restore-db": "bash scripts/restore-db.sh",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "create-admin": "tsx src/scripts/createAdmin.ts",
    "purge-idempotency": "tsx src/scripts/purgeIdempotency.ts",
    "fix-box-stock": "tsx src/scripts/fixBoxStock.ts",
    "merge-count-lots": "tsx src/scripts/mergeCountLots.ts",
    "projesctStructure": "tree -I 'node_modules'"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "fast-xml-parser": "^5.5.7",
    "fastify": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.19.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/pdfkit": "^0.17.6",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.19.2",
    "tsup": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
