{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ES2022",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "baseUrl": "src",
    "paths": {
      "@catalog/*": ["modules/catalog/*"],
      "@receivables/*": ["modules/receivables/*"],
      "@payables/*": ["modules/payables/*"],
      "@shared/*": ["shared/*"]
    }
  }
}