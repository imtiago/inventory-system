# Banco de desenvolvimento / produção (obrigatório; URL do Postgres)
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/inventory"
# Banco usado por `npm test` (o nome DEVE terminar em _test). Crie com `npm run test:db:prepare`.
TEST_DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/inventory_test"

# Segredo do JWT (obrigatório). Em produção: no mínimo 32 caracteres.
# Gere com: openssl rand -base64 48
JWT_SECRET="troque-por-um-segredo-longo"

# Porta e interface do servidor (padrões: 3000 e 0.0.0.0)
# PORT=3000
# HOST=0.0.0.0

# NODE_ENV=production liga as validações estritas (segredo >= 32 caracteres e CORS_ORIGINS obrigatório).
# NODE_ENV=production

# Origens permitidas no CORS, separadas por vírgula. Obrigatório em produção;
# fora de produção, se ausente, a origem da requisição é refletida.
# CORS_ORIGINS="https://app.exemplo.com,https://admin.exemplo.com"

# Atrás de proxy reverso: true, número de saltos (ex.: 1) ou lista de IPs do proxy,
# para o rate limit e o limitador de login verem o IP real do cliente.
# TRUST_PROXY=1

# Somente fora de produção: desliga o rate limit global (a suíte de testes já faz isso).
# RATE_LIMIT_DISABLED=1
